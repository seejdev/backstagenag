---
layout: layouts/base.njk
title: Upcoming Shows
description: Upcoming live music at Backstage @ NAG in Londonderry, Vermont.
permalink: /events/
---
<div class="container py-5">
  <h1 class="display-4">Upcoming shows</h1>
  <article class="bsn-card bsn-open-mic bsn-open-mic-feature mt-4">
    <div class="bsn-card-link">
      <div class="bsn-date" aria-hidden="true">
        <span class="bsn-date-day">Thu</span>
        <span class="bsn-date-month">7pm</span>
      </div>
      <div class="bsn-card-body">
        <h2 class="bsn-card-title mb-1">Open Mic Night</h2>
        <p class="bsn-card-meta fs-5">Every Thursday at 7:00 PM</p>
        <p class="mb-0">Sign-ups at the door. Every Thursday, 7:00 PM.</p>
      </div>
    </div>
  </article>
  {%- set groups = collections.upcomingEvents | groupByMonth %}
  {%- if groups.length %}
  {%- for group in groups %}
  <h2 class="bsn-section-title mt-5">{{ group.label }}</h2>
  <div class="bsn-card-grid">
    {%- for event in group.items %}
    {% include "partials/event-card.njk" %}
    {%- endfor %}
  </div>
  {%- endfor %}
  {%- else %}
  <p class="lead text-body-secondary">Nothing else on the calendar yet — check back soon.</p>
  {%- endif %}
  <p class="mt-5"><a href="/events/past/">Past shows &rarr;</a></p>
</div>
