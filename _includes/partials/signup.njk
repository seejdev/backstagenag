<form class="bsn-signup" id="bsn-signup" action="/thanks/">
  <p class="bsn-signup-title">Get the list</p>
  <p class="bsn-signup-note">New shows, straight to your inbox.</p>
  <div class="bsn-signup-row">
    <input type="email" name="email" placeholder="you@email.com" aria-label="Email address" required>
    <button class="btn btn-accent" type="submit">Join</button>
  </div>
</form>
<script>
document.getElementById("bsn-signup").addEventListener("submit", async (event) => {
  event.preventDefault();
  const form = event.currentTarget;
  const email = new FormData(form).get("email");
  const body = new URLSearchParams();
  body.set("entry.1716044758", email);
  try {
    await fetch("https://docs.google.com/forms/d/e/1FAIpQLSc3fzbN30vhUJ6kq7qh5TIVbS8dNfNQsNaOGKTXYz-DGEQgFg/formResponse", {
      method: "POST",
      mode: "no-cors",
      body
    });
  } catch (error) {}
  window.location = "/thanks/";
});
</script>
