{%- set a = venue.address %}
<div class="bsn-facts">
  <section class="bsn-fact">
    <h2>Where</h2>
    <address>
      {{ a.street }}<br>
      {{ a.city }}, {{ a.state }} {{ a.zip }}
    </address>
    {%- if venue.mapUrl %}<a href="{{ venue.mapUrl }}" rel="noopener">Open in maps</a>{%- endif %}
    {%- if venue.parking %}<p><strong>Parking</strong> {{ venue.parking }}</p>{%- endif %}
  </section>
  <section class="bsn-fact">
    <h2>Hours</h2>
    <p>{{ venue.hoursNote }}</p>
  </section>
  <section class="bsn-fact">
    <h2>Good to know</h2>
    <dl>
      <div><dt>Capacity</dt><dd>{{ venue.capacity }}</dd></div>
      <div><dt>Ages</dt><dd>{{ venue.agePolicy }}</dd></div>
      <div><dt>Cover</dt><dd>{{ venue.cover }}</dd></div>
    </dl>
  </section>
  <section class="bsn-fact">
    <h2>Contact</h2>
    <p><a href="mailto:{{ venue.email }}">{{ venue.email }}</a></p>
    <p>In person at {% if venue.inPerson.url %}<a href="{{ venue.inPerson.url }}" rel="noopener">{{ venue.inPerson.name }}</a>{% else %}{{ venue.inPerson.name }}{% endif %}</p>
  </section>
</div>
